# League Lab local configuration. Copy to .env (git-ignored) and fill in the passwords.
# scripts/bootstrap.sh generates this file for you on first run.

# --- Postgres: pipeline role (owns raw/staging/analytics; used by ingestion and dbt) ---
LEAGUE_LAB_DB_HOST=localhost
LEAGUE_LAB_DB_PORT=5432
LEAGUE_LAB_DB_NAME=league_lab
LEAGUE_LAB_DB_USER=league_lab_pipeline
LEAGUE_LAB_DB_PASSWORD=change-me
# Optional full DSN override (e.g. a hosted Postgres later). If set, the parts above are ignored.
# LEAGUE_LAB_DB_URL=postgresql://user:pass@host:5432/league_lab?sslmode=require

# --- Postgres: read-only application role (Streamlit explorer) ---
LEAGUE_LAB_APP_DB_USER=league_lab_app
LEAGUE_LAB_APP_DB_PASSWORD=change-me
# LEAGUE_LAB_APP_DB_URL=postgresql://league_lab_app:pass@host:5432/league_lab?sslmode=require

# --- Sleeper ---
# newest league id of each chain to load; comma-separate to load several leagues into one database
LEAGUE_LAB_SLEEPER_LEAGUE_ID=1389709692405551104

# --- History window (NFL season years) ---
LEAGUE_LAB_SEASONS_START=2016
# Play-by-play column set: core (~190 columns, default) or all (~370). The archive keeps every column either way.
LEAGUE_LAB_PBP_COLUMNS=core

# --- Paths (default: <repo>/data). Raw archive lives under $LEAGUE_LAB_DATA_DIR/raw ---
# LEAGUE_LAB_DATA_DIR=/Users/you/PycharmProjects/league-lab/data

# --- dbt ---
DBT_PROFILES_DIR=config/dbt

# --- Hosting (plan S-03): publish the marts to a hosted Postgres after each refresh ---
# Owner connection string of the hosted database (Neon / Supabase "postgres" role) and the password
# to set for the read-only league_lab_app role there. Leave unset to keep everything local.
# LEAGUE_LAB_HOSTED_ADMIN_URL=postgresql://neondb_owner:...@ep-....neon.tech/neondb?sslmode=require
# LEAGUE_LAB_HOSTED_APP_PASSWORD=choose-a-long-password

# --- PlayerWire briefs on the player card (plan N2, docs/PLAYERWIRE.md). The Mac is the only writer of the hosted
# schema `playerwire`; leave these unset to keep the news line on ESPN only.
# PLAYERWIRE_API_URL=http://127.0.0.1:8790
# PLAYERWIRE_API_KEY=pwk_<from: python3 -m pw client create --name league-lab --scopes read>
# PLAYERWIRE_WRITER_PASSWORD=<openssl rand -hex 24>
# PLAYERWIRE_HOSTED_URL=postgresql://playerwire_writer:<PLAYERWIRE_WRITER_PASSWORD>@ep-....neon.tech/neondb?sslmode=require
