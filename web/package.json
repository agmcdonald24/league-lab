{
  "name": "league-lab-web",
  "private": true,
  "version": "0.1.0",
  "description": "League Lab phone web app (plan D7 spike): My Week and the player card over the read-only API",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8582 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port 8582",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && npm run typecheck",
    "e2e": "playwright test",
    "measure": "playwright test --config playwright.measure.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
